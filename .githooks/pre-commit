#!/usr/bin/env bash
# pre-commit hook — bloquea secretos, archivos gigantes y otras cosas peligrosas
# antes de que entren al repo.
#
# Instalado por: dev-standards/hooks/install-hooks.sh
# Saltar (en emergencia): git commit --no-verify
#                         (el estándar dice no hacerlo salvo que sepas qué hacés)

set -e

RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m'

errors=0

# ---------- 1. Archivos > 50 MB ----------
LIMIT_BYTES=$((50 * 1024 * 1024))
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  [[ ! -f "$file" ]] && continue
  size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo 0)
  if (( size > LIMIT_BYTES )); then
    echo -e "${RED}[BLOQUEADO]${NC} archivo > 50 MB: $file ($((size / 1024 / 1024)) MB)"
    echo "  → Si querés subirlo igual, agregalo a Git LFS o publicalo como Release asset."
    errors=$((errors + 1))
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

# ---------- 2. Secretos y credenciales ----------
# Patrones que NUNCA deberían entrar al repo.
SECRET_PATTERNS=(
  '-----BEGIN (RSA |OPENSSH |EC |DSA |PGP |ENCRYPTED )?PRIVATE KEY-----'
  'AKIA[0-9A-Z]{16}'                          # AWS Access Key
  'ghp_[A-Za-z0-9]{36}'                       # GitHub PAT
  'gho_[A-Za-z0-9]{36}'                       # GitHub OAuth
  'ghs_[A-Za-z0-9]{36}'                       # GitHub server-to-server
  'sk-[A-Za-z0-9]{32,}'                       # OpenAI / Anthropic-like
  'sk-ant-[A-Za-z0-9-]{32,}'                  # Anthropic
  'xox[baprs]-[A-Za-z0-9-]{10,}'              # Slack
  'AIza[0-9A-Za-z_-]{35}'                     # Google API
  'eyJ[A-Za-z0-9_-]{20,}\.eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}'  # JWT
)

while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  [[ ! -f "$file" ]] && continue
  # Solo texto.
  if file --brief --mime-encoding "$file" 2>/dev/null | grep -qE 'binary|charset=binary'; then
    continue
  fi

  staged_added_lines=$(git diff --cached -U0 -- "$file" | grep -E '^\+' || true)
  [[ -z "$staged_added_lines" ]] && continue

  for pattern in "${SECRET_PATTERNS[@]}"; do
    # Solo chequear el diff staged, no el archivo entero (evita falsos
    # positivos por contenido pre-existente que no tocamos). `grep -e` evita
    # interpretar patrones que empiezan con '-' como flags.
    if printf '%s\n' "$staged_added_lines" | grep -qE -e "$pattern"; then
      echo -e "${RED}[BLOQUEADO]${NC} posible secreto detectado en: $file"
      echo "  Pattern: $pattern"
      echo "  → No se imprime la línea detectada para no exponer secretos en logs."
      echo "  → Revisá el diff staged con cuidado: git diff --cached -- '$file'"
      errors=$((errors + 1))
    fi
  done
done < <(git diff --cached --name-only --diff-filter=ACMR)

# ---------- 3. Archivos típicos de secretos ----------
DANGEROUS_NAMES=(
  '\.env$'
  '\.env\.[^t]'  # .env.local, .env.prod (pero permite .env.template)
  '\.p12$'
  '\.pem$'
  '\.key$'
  'credentials\.json$'
  'service-account.*\.json$'
  'id_rsa$'
  'id_ed25519$'
)

while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  for pattern in "${DANGEROUS_NAMES[@]}"; do
    if echo "$file" | grep -qE "$pattern"; then
      echo -e "${RED}[BLOQUEADO]${NC} archivo con nombre peligroso: $file"
      echo "  → Si es intencional (ej. template), agregalo a .gitignore con excepción."
      errors=$((errors + 1))
    fi
  done
done < <(git diff --cached --name-only --diff-filter=ACMR)

# ---------- Resultado ----------
if (( errors > 0 )); then
  echo ""
  echo -e "${RED}✗ Pre-commit falló con $errors problema(s).${NC}"
  echo "Commit abortado."
  exit 1
fi

# Silencioso si todo OK — sin spam.
exit 0
